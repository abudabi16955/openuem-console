package profiles_views

import (
	"fmt"
	"github.com/invopop/ctxi18n/i18n"
	"github.com/labstack/echo/v4"
	"github.com/open-uem/ent"
	"github.com/open-uem/openuem-console/internal/views/partials"
	"strings"
	"time"
)

templ ProfilesIssues(c echo.Context, p partials.PaginationAndSort, issues []*ent.ProfileIssue, profile *ent.Profile, itemsPerPage int, commonInfo *partials.CommonInfo) {
	@partials.Header(c, []partials.Breadcrumb{{Title: i18n.T(ctx, "Profile Management"), Url: string(templ.URL(partials.GetNavigationUrl(commonInfo, "/profiles")))}, {Title: profile.Name, Url: string(templ.URL(partials.GetNavigationUrl(commonInfo, fmt.Sprintf("/profiles/%d", profile.ID))))}, {Title: i18n.T(ctx, "profiles.issues.title")}}, commonInfo)
	<main class="grid flex-1 items-start gap-4 p-4 sm:px-6 sm:py-0 md:gap-8">
		<div id="error" class="hidden"></div>
		<div class="uk-width-2-3@m uk-card uk-card-default">
			<div class="uk-card-header">
				<div class="flex justify-between items-center">
					<div class="flex flex-col my-4 mx-1">
						<h3 class="uk-card-title">{ i18n.T(ctx, "profiles.issues.title") }</h3>
						<p class="uk-margin-small-top uk-text-small">
							{ i18n.T(ctx, "profiles.issues.description") }
						</p>
					</div>
				</div>
			</div>
			<div class="uk-card-body flex flex-col gap-4">
				if len(issues) > 0 {
					<table class="uk-table uk-table-divider uk-table-small uk-table-hover uk-table-striped mt-6">
						<thead>
							<tr>
								<th class="w-1/6"><span>{ i18n.T(ctx, "profiles.issues.endpoint") }</span></th>
								<th class="w-1/6"><span>{ i18n.T(ctx, "profiles.issues.last_report") }</span></th>
								<th class="w-2/3"><span>{ i18n.T(ctx, "profiles.issues.tasks_report") }</span></th>
							</tr>
						</thead>
						for index, issue := range issues {
							if issue.Edges.Agents != nil {
								<tr>
									<td class="!align-middle">
										<a
											href={ templ.URL(partials.GetNavigationUrl(commonInfo, fmt.Sprintf("/computers/%s", issue.Edges.Agents.ID))) }
											hx-get={ string(templ.URL(partials.GetNavigationUrl(commonInfo, fmt.Sprintf("/computers/%s", issue.Edges.Agents.ID)))) }
											hx-push-url="true"
											hx-target="#main"
											hx-swap="outerHTML"
											class="underline cursor-pointer"
										>
											{ issue.Edges.Agents.Nickname }
										</a>
									</td>
									<td class="!align-middle">
										{ issue.When.Local().String() }
									</td>
									<td class="flex flex-col gap-4 !align-middle">
										if issue.Error != "" {
											for line := range strings.SplitSeq(issue.Error, ", ") {
												<p>{ line }</p>
											}
										} else {
											if len(issue.Edges.Tasksreports) > 0 {
												<div class="flex flex-wrap items-center gap-2">
													if getRunningTasks(issue.Edges.Tasksreports) > 0 {
														<span class="text-blue-600 font-medium">{ i18n.T(ctx, "profiles.issues.tasks_report_running_summary", getRunningTasks(issue.Edges.Tasksreports)) }</span>
													}
													if getSuccessfulTasks(issue.Edges.Tasksreports) > 0 {
														<span class="text-green-600 font-medium">{ i18n.T(ctx, "profiles.issues.tasks_report_successful_summary", getSuccessfulTasks(issue.Edges.Tasksreports)) }</span>
													}
													if getFailedTasks(issue.Edges.Tasksreports) > 0 {
														<span class="text-red-600 font-medium">{ i18n.T(ctx, "profiles.issues.tasks_report_failed_summary", getFailedTasks(issue.Edges.Tasksreports)) }</span>
													}
													if getTimeoutTasks(issue.Edges.Tasksreports) > 0 {
														<span class="text-amber-600 font-medium">{ i18n.T(ctx, "profiles.issues.tasks_report_timeout_summary", getTimeoutTasks(issue.Edges.Tasksreports)) }</span>
													}
													if getPendingTasks(issue.Edges.Tasksreports) > 0 {
														<span class="text-gray-500 font-medium">{ i18n.T(ctx, "profiles.issues.tasks_report_pending_summary", getPendingTasks(issue.Edges.Tasksreports)) }</span>
													}
													<a class="underline cursor-pointer ml-2" href={ fmt.Sprintf("#modal-overflow-%d", index) } uk-toggle>{ i18n.T(ctx, "profiles.issues.tasks_report_more_info") }</a>
												</div>
												<div id={ fmt.Sprintf("modal-overflow-%d", index) } uk-modal>
													<div id="profile-report-modal" class="uk-margin-auto-vertical uk-modal-dialog w-2/3">
														<button id={ fmt.Sprintf("profile-report-modal-close-%d", index) } class="uk-modal-close-default dark:text-white" type="button" uk-close></button>
														<div class="flex flex-col gap-4 uk-modal-body" uk-overflow-auto>
															<h2 class="uk-modal-title dark:text-white">{ i18n.T(ctx, "profiles.issues.tasks_report_for", issue.Edges.Agents.Nickname) }</h2>
															@ReportDetail(issue, commonInfo, index)
														</div>
													</div>
												</div>
											} else {
												{ "-" }
											}
										}
									</td>
								</tr>
							}
						}
					</table>
					@partials.Pagination(c, p, "get", "#main", "outerHTML", string(templ.URL(partials.GetNavigationUrl(commonInfo, fmt.Sprintf("/profiles/%d/issues", profile.ID)))), itemsPerPage)
				} else {
					<p class="uk-text-small uk-text-muted mt-6">
						{ i18n.T(ctx, "profiles.issues.no_issues") }
					</p>
				}
			</div>
		</div>
	</main>
}

templ ReportDetail(issue *ent.ProfileIssue, commonInfo *partials.CommonInfo, index int) {
	<table class="uk-table uk-table-divider uk-table-small uk-table-hover uk-table-striped uk-overflow-auto">
		for _, t := range issue.Edges.Tasksreports {
			if t.Edges.Task != nil && !t.Edges.Task.Disabled {
				<tr>
					<th class="align-middle" rowspan="6">
						<div class="flex items-center gap-2">
							if t.Timeout {
								<span class="uk-badge bg-amber-500 text-white">{ i18n.T(ctx, "tasks.status.timeout") }</span>
							} else if t.Failed || t.Status.String() == "failed" {
								@partials.Crossmark()
							} else if t.Status.String() == "running" {
								<span class="uk-badge uk-badge-primary">{ i18n.T(ctx, "tasks.status.running") }</span>
							} else if t.Status.String() == "completed" || t.End != "" {
								@partials.Checkmark()
							} else {
								<span class="uk-badge uk-badge-secondary">{ i18n.T(ctx, "tasks.status.pending") }</span>
							}
							<a
								href={ templ.URL(partials.GetNavigationUrl(commonInfo, fmt.Sprintf("/tasks/%d", t.Edges.Task.ID))) }
								hx-get={ string(templ.URL(partials.GetNavigationUrl(commonInfo, fmt.Sprintf("/tasks/%d", t.Edges.Task.ID)))) }
								hx-push-url="true"
								hx-target="#main"
								hx-swap="outerHTML"
								class="underline hover:cursor-pointer font-medium"
								_={ fmt.Sprintf("on click call #profile-report-modal-close-%d.click()", index) }
							>{ t.Edges.Task.Name }</a>
						</div>
					</th>
					<th><span class="text-nowrap">{ i18n.T(ctx, "tasks.status.label") }</span></th>
					<td class="dark:text-white">
						if t.Timeout {
							<span class="uk-badge bg-amber-500 text-white">{ i18n.T(ctx, "tasks.status.timeout") }</span>
						} else {
							switch t.Status.String() {
								case "running":
									<span class="uk-badge uk-badge-primary">{ i18n.T(ctx, "tasks.status.running") }</span>
								case "completed":
									<span class="uk-badge bg-green-600 text-white">{ i18n.T(ctx, "tasks.status.completed") }</span>
								case "failed":
									<span class="uk-badge uk-badge-danger">{ i18n.T(ctx, "tasks.status.failed") }</span>
								case "pending":
									<span class="uk-badge uk-badge-secondary">{ i18n.T(ctx, "tasks.status.pending") }</span>
								default:
									if t.Failed {
										<span class="uk-badge uk-badge-danger">{ i18n.T(ctx, "tasks.status.failed") }</span>
									} else {
										<span class="uk-badge uk-badge-secondary">{ i18n.T(ctx, "tasks.status.pending") }</span>
									}
							}
						}
					</td>
				</tr>
				<tr>
					<th><span class="text-nowrap">{ i18n.T(ctx, "tasks.started_at") }</span></th>
					<td class="dark:text-white">{ formatTime(t.StartedAt, commonInfo) }</td>
				</tr>
				<tr>
					<th><span class="text-nowrap">{ i18n.T(ctx, "tasks.ended_at") }</span></th>
					<td class="dark:text-white">{ formatTime(t.End, commonInfo) }</td>
				</tr>
				<tr>
					<th><span class="text-nowrap">{ i18n.T(ctx, "tasks.timeout") }</span></th>
					<td class="dark:text-white">
						if t.Timeout {
							<span class="text-amber-600 font-semibold">{ i18n.T(ctx, "tasks.timed_out") }</span>
						} else {
							<span class="text-gray-500">-</span>
						}
					</td>
				</tr>
				<tr>
					<th><span class="text-nowrap">{ i18n.T(ctx, "profiles.standard_output") }</span></th>
					<td class="dark:text-white font-mono text-xs whitespace-pre-wrap">{ t.StdOutput }</td>
				</tr>
				<tr>
					<th><span class="text-nowrap">{ i18n.T(ctx, "profiles.standard_error") }</span></th>
					<td class="dark:text-white font-mono text-xs text-red-600 dark:text-red-400 whitespace-pre-wrap">{ t.StdError }</td>
				</tr>
			}
		}
	</table>
}

func formatTime(when string, commonInfo *partials.CommonInfo) string {
	if when == "" {
		return "-"
	}
	t, err := time.ParseInLocation(time.RFC3339Nano, when, time.Local)
	if err == nil {
		return commonInfo.Translator.FmtDateMedium(t.Local()) + " " + commonInfo.Translator.FmtTimeMedium(t.Local())
	}
	t, err = time.Parse(time.RFC3339, when)
	if err == nil {
		return commonInfo.Translator.FmtDateMedium(t.Local()) + " " + commonInfo.Translator.FmtTimeMedium(t.Local())
	}
	return when
}

func getFailedTasks(taskReports []*ent.TaskReport) int {
	failed := 0

	for _, t := range taskReports {
		if t.Edges.Task != nil && !t.Edges.Task.Disabled && (t.Failed || t.Status.String() == "failed") && !t.Timeout {
			failed++
		}
	}

	return failed
}

func getTimeoutTasks(taskReports []*ent.TaskReport) int {
	timeout := 0

	for _, t := range taskReports {
		if t.Edges.Task != nil && !t.Edges.Task.Disabled && t.Timeout {
			timeout++
		}
	}

	return timeout
}

func getRunningTasks(taskReports []*ent.TaskReport) int {
	running := 0

	for _, t := range taskReports {
		if t.Edges.Task != nil && !t.Edges.Task.Disabled && t.Status.String() == "running" && !t.Timeout && !t.Failed {
			running++
		}
	}

	return running
}

func getSuccessfulTasks(taskReports []*ent.TaskReport) int {
	successful := 0

	for _, t := range taskReports {
		if t.Edges.Task != nil && !t.Edges.Task.Disabled && !t.Failed && !t.Timeout && (t.Status.String() == "completed" || t.End != "") {
			successful++
		}
	}

	return successful
}

func getPendingTasks(taskReports []*ent.TaskReport) int {
	pending := 0

	for _, t := range taskReports {
		if t.Edges.Task != nil && !t.Edges.Task.Disabled && (t.Status.String() == "pending" || (t.StartedAt == "" && t.End == "" && !t.Failed && !t.Timeout)) {
			pending++
		}
	}

	return pending
}
