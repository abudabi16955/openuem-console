package packages_views

import (
	"fmt"
	"strings"

	"github.com/invopop/ctxi18n/i18n"
	"github.com/labstack/echo/v4"
	ent "github.com/open-uem/ent"
	"github.com/open-uem/ent/selfservicepackage"
	"github.com/open-uem/openuem-console/internal/views/filters"
	"github.com/open-uem/openuem-console/internal/views/layout"
	"github.com/open-uem/openuem-console/internal/views/partials"
	"github.com/open-uem/openuem-console/internal/views/software_views"
)

var standardIcons = []string{
	"package", "app-window", "globe", "terminal", "code", "file-text", "folder",
	"hard-drive", "server", "database", "shield", "shield-check", "lock", "cpu",
	"tool", "settings", "play", "music", "video", "image", "cloud", "archive",
	"bookmark", "sparkles", "zap", "check-circle", "activity", "layers", "monitor",
	"power", "download", "link", "key", "bell", "wifi", "printer",
}

func getPackagePlatform(pkg *ent.SelfServicePackage) string {
	if pkg.PackageType == selfservicepackage.PackageTypeMsi ||
		pkg.PackageType == selfservicepackage.PackageTypeExe ||
		pkg.PackageType == selfservicepackage.PackageTypeWinget {
		return "Windows"
	}

	lower := strings.ToLower(pkg.Name + " " + pkg.Description + " " + pkg.Category)
	if strings.Contains(lower, "macos") || strings.Contains(lower, "darwin") || strings.Contains(lower, "osx") || strings.Contains(lower, "mac os") {
		return "macOS"
	}
	if strings.Contains(lower, "linux") || strings.Contains(lower, "ubuntu") || strings.Contains(lower, "debian") {
		return "Linux"
	}
	return "Windows"
}

templ Packages(c echo.Context, p partials.PaginationAndSort, f filters.SelfServicePackageFilter, pkgs []*ent.SelfServicePackage, itemsPerPage int, commonInfo *partials.CommonInfo) {
	@partials.Header(c, []partials.Breadcrumb{{Title: i18n.T(ctx, "Software", i18n.Default("Software")), Url: string(templ.URL(partials.GetNavigationUrl(commonInfo, "/software")))}, {Title: i18n.T(ctx, "software.tabs.packages", i18n.Default("Packages")), Url: string(templ.URL(partials.GetNavigationUrl(commonInfo, "/software/packages")))}}, commonInfo)
	<main class="grid flex-1 items-start gap-4 p-4 sm:px-6 sm:py-0 md:gap-8">
		<div id="error" class="hidden"></div>
		<div id="success" class="hidden"></div>
		<div class="uk-width-1-2@m uk-card uk-card-default">
			<div class="uk-card-header">
				@software_views.SoftwareNavbar("packages", commonInfo)
				<div class="flex justify-between items-center mt-4">
							<div class="flex flex-col">
								<h3 class="uk-card-title">{ i18n.T(ctx, "packages.title", i18n.Default("Self-Service Packages")) }</h3>
								<p class="uk-margin-small-top uk-text-small text-muted-foreground">
									{ i18n.T(ctx, "packages.description", i18n.Default("Manage software packages available for user self-service installation")) }
								</p>
							</div>
							<div>
								<button
									type="button"
									class="uk-button uk-button-primary flex items-center gap-2"
									uk-toggle="target: #new-package-modal"
								>
									<uk-icon hx-history="false" icon="plus" custom-class="h-4 w-4" uk-cloak></uk-icon>
									<span>{ i18n.T(ctx, "packages.new", i18n.Default("New Package")) }</span>
								</button>
							</div>
						</div>
					</div>
					<div class="uk-card-body flex flex-col gap-4">
						<div class="flex justify-between items-center">
							<div class="flex gap-4 items-center">
								<form
									class="flex items-center gap-3"
									hx-post={ string(templ.URL(partials.GetNavigationUrl(commonInfo, "/software/packages"))) }
									hx-target="#main"
									hx-swap="outerHTML"
									hx-push-url="false"
								>
									<div class="uk-search uk-search-default w-64">
										<span uk-search-icon></span>
										<input
											class="uk-search-input"
											type="search"
											name="search"
											placeholder={ i18n.T(ctx, "Search", i18n.Default("Search...")) }
											value={ f.Search }
											aria-label="Search"
										/>
									</div>
									<select
										name="type"
										class="uk-select text-xs h-9 rounded w-36"
										onchange="this.form.requestSubmit()"
									>
										<option value="" selected?={ f.Type == "" }>{ i18n.T(ctx, "packages.all_types", i18n.Default("All Types")) }</option>
										<option value="msi" selected?={ f.Type == "msi" }>MSI</option>
										<option value="exe" selected?={ f.Type == "exe" }>EXE</option>
										<option value="zip" selected?={ f.Type == "zip" }>ZIP/SCRIPT</option>
										<option value="winget" selected?={ f.Type == "winget" }>WINGET</option>
									</select>
								</form>
								if f.Search != "" || f.Category != "" || f.Type != "" || f.Enabled != "" {
									<a
										href={ templ.URL(partials.GetNavigationUrl(commonInfo, "/software/packages")) }
										hx-get={ string(templ.URL(partials.GetNavigationUrl(commonInfo, "/software/packages"))) }
										hx-target="#main"
										hx-swap="outerHTML"
										class="uk-button uk-button-default text-xs flex items-center"
									>
										{ i18n.T(ctx, "Clean", i18n.Default("Clear")) }
									</a>
								}
							</div>
						</div>
						if len(pkgs) > 0 {
							<table class="uk-table uk-table-divider uk-table-small uk-table-striped uk-table-hover">
								<thead>
									<tr>
										<th>
											<div class="flex gap-1 items-center">
												<span>{ i18n.T(ctx, "packages.name", i18n.Default("Name")) }</span>
												@partials.SortByColumnIcon(c, p, i18n.T(ctx, "packages.name", i18n.Default("Name")), "name", "alpha", "#main", "outerHTML", "get")
											</div>
										</th>
										<th>
											<div class="flex gap-1 items-center">
												<span>{ i18n.T(ctx, "packages.category", i18n.Default("Category")) }</span>
												@partials.SortByColumnIcon(c, p, i18n.T(ctx, "packages.category", i18n.Default("Category")), "category", "alpha", "#main", "outerHTML", "get")
											</div>
										</th>
										<th>{ i18n.T(ctx, "packages.platform", i18n.Default("Platform")) }</th>
										<th>
											<div class="flex gap-1 items-center">
												<span>{ i18n.T(ctx, "packages.package_type", i18n.Default("Type")) }</span>
												@partials.SortByColumnIcon(c, p, i18n.T(ctx, "packages.package_type", i18n.Default("Type")), "type", "alpha", "#main", "outerHTML", "get")
											</div>
										</th>
										<th>{ i18n.T(ctx, "packages.source_type", i18n.Default("Source")) }</th>
										<th>{ i18n.T(ctx, "packages.execution_context", i18n.Default("Context")) }</th>
										<th>{ i18n.T(ctx, "packages.status", i18n.Default("Status")) }</th>
										<th class="text-right">{ i18n.T(ctx, "Actions", i18n.Default("Actions")) }</th>
									</tr>
								</thead>
								<tbody>
									for _, pkg := range pkgs {
										<tr>
											<td class="!align-middle">
												<div class="flex flex-col">
													<div class="flex items-center gap-2">
														if pkg.Icon != "" {
															if strings.HasPrefix(pkg.Icon, "data:image/") || strings.HasPrefix(pkg.Icon, "http://") || strings.HasPrefix(pkg.Icon, "https://") {
																<img src={ pkg.Icon } class="h-4 w-4 object-contain inline-block" alt="" />
															} else {
																<uk-icon icon={ pkg.Icon } custom-class="h-4 w-4 text-primary" uk-cloak></uk-icon>
															}
														} else {
															<uk-icon icon="package" custom-class="h-4 w-4 text-muted-foreground" uk-cloak></uk-icon>
														}
														<span class="font-medium">{ pkg.Name }</span>
														if pkg.Version != "" {
															<span class="text-xs text-muted-foreground">v{ pkg.Version }</span>
														}
													</div>
													if pkg.Description != "" {
														<span class="text-xs text-muted-foreground truncate max-w-xs">{ pkg.Description }</span>
													}
												</div>
											</td>
											<td class="!align-middle">
												<span class="uk-badge uk-badge-default text-xs">{ pkg.Category }</span>
											</td>
											<td class="!align-middle">
												switch getPackagePlatform(pkg) {
													case "macOS":
														<span class="uk-badge bg-zinc-700 text-white text-xs px-2 py-0.5 rounded font-mono">macOS</span>
													case "Linux":
														<span class="uk-badge bg-orange-600 text-white text-xs px-2 py-0.5 rounded font-mono">Linux</span>
													default:
														<span class="uk-badge bg-sky-700 text-white text-xs px-2 py-0.5 rounded font-mono">Windows</span>
												}
											</td>
											<td class="!align-middle">
												switch pkg.PackageType {
													case selfservicepackage.PackageTypeMsi:
														<span class="uk-badge bg-blue-600 text-white uppercase text-xs px-2 py-0.5 rounded font-mono">MSI</span>
													case selfservicepackage.PackageTypeExe:
														<span class="uk-badge bg-amber-400 text-zinc-950 font-bold uppercase text-xs px-2 py-0.5 rounded font-mono">EXE</span>
													case selfservicepackage.PackageTypeZip:
														<span class="uk-badge bg-purple-600 text-white uppercase text-xs px-2 py-0.5 rounded font-mono">ZIP/SCRIPT</span>
													case selfservicepackage.PackageTypeWinget:
														<span class="uk-badge bg-emerald-600 text-white uppercase text-xs px-2 py-0.5 rounded font-mono">WINGET</span>
												}
											</td>
											<td class="!align-middle text-xs">
												if pkg.SourceType == selfservicepackage.SourceTypeUpload {
													<span class="flex items-center gap-1 text-muted-foreground">
														<uk-icon icon="hard-drive-upload" custom-class="h-3.5 w-3.5" uk-cloak></uk-icon>
														{ i18n.T(ctx, "packages.upload", i18n.Default("Upload")) }
													</span>
												} else {
													<span class="flex items-center gap-1 text-muted-foreground" title={ pkg.SourceURL }>
														<uk-icon icon="globe" custom-class="h-3.5 w-3.5" uk-cloak></uk-icon>
														{ i18n.T(ctx, "packages.https", i18n.Default("HTTPS")) }
													</span>
												}
											</td>
											<td class="!align-middle">
												if pkg.ExecutionContext == selfservicepackage.ExecutionContextSystem {
													<span class="uk-badge bg-slate-200 text-slate-900 border border-slate-300 font-bold text-xs px-2 py-0.5 rounded uppercase font-mono">SYSTEM</span>
												} else {
													<span class="uk-badge bg-cyan-700 text-white text-xs px-2 py-0.5 rounded uppercase font-mono">USER</span>
												}
											</td>
											<td class="!align-middle">
												if pkg.Enabled {
													<span class="flex items-center gap-1 text-green-600 text-xs font-semibold">
														<span class="w-2 h-2 rounded-full bg-green-500"></span>
														{ i18n.T(ctx, "packages.enabled", i18n.Default("Enabled")) }
													</span>
												} else {
													<span class="flex items-center gap-1 text-muted-foreground text-xs font-semibold">
														<span class="w-2 h-2 rounded-full bg-zinc-400"></span>
														{ i18n.T(ctx, "packages.disabled", i18n.Default("Disabled")) }
													</span>
												}
											</td>
											<td class="!align-middle text-right">
												<div class="flex items-center justify-end gap-2">
													if pkg.SourceType == selfservicepackage.SourceTypeUpload && pkg.FilePath != "" {
														<a
															href={ templ.URL(fmt.Sprintf("/api/v1/packages/download/%s", pkg.ID.String())) }
															title={ i18n.T(ctx, "packages.download", i18n.Default("Download")) }
															class="uk-button uk-button-small uk-button-default"
															download
														>
															<uk-icon hx-history="false" icon="download" custom-class="h-3.5 w-3.5" uk-cloak></uk-icon>
														</a>
													}
													<button
														type="button"
														title={ i18n.T(ctx, "packages.edit", i18n.Default("Edit")) }
														class="uk-button uk-button-small uk-button-default"
														uk-toggle={ fmt.Sprintf("target: #edit-package-modal-%s", pkg.ID.String()) }
													>
														<uk-icon hx-history="false" icon="pencil" custom-class="h-3.5 w-3.5" uk-cloak></uk-icon>
													</button>
													<button
														type="button"
														title={ i18n.T(ctx, "packages.delete", i18n.Default("Delete")) }
														class="uk-button uk-button-small uk-button-danger text-white hover:bg-red-700"
														uk-toggle={ fmt.Sprintf("target: #delete-package-modal-%s", pkg.ID.String()) }
													>
														<uk-icon hx-history="false" icon="trash-2" custom-class="h-3.5 w-3.5 text-white" uk-cloak></uk-icon>
													</button>
												</div>
												@EditPackageModal(pkg, commonInfo)
												@DeletePackageModal(pkg, commonInfo)
											</td>
										</tr>
									}
								</tbody>
							</table>
							@partials.Pagination(c, p, "get", "#main", "outerHTML", string(templ.URL(partials.GetNavigationUrl(commonInfo, "/software/packages"))), itemsPerPage)
						} else {
							<div class="p-8 text-center text-muted-foreground">
								<uk-icon icon="package" custom-class="h-10 w-10 mx-auto mb-2 text-muted-foreground opacity-50" uk-cloak></uk-icon>
								<p class="uk-text-small">{ i18n.T(ctx, "packages.no_packages", i18n.Default("No self-service packages configured yet")) }</p>
							</div>
						}
			</div>
		</div>
		@NewPackageModal(commonInfo)
		<script>
			function selectPackageIcon(inputId, previewId, iconName, btn) {
				var input = document.getElementById(inputId);
				var preview = document.getElementById(previewId);
				if (input) {
					input.value = iconName;
				}
				if (preview) {
					preview.innerHTML = '';
					var ic = document.createElement('uk-icon');
					ic.setAttribute('icon', iconName);
					ic.setAttribute('custom-class', 'h-4 w-4 text-primary');
					ic.setAttribute('uk-cloak', '');
					preview.appendChild(ic);
				}
				if (btn) {
					var dd = btn.closest('[uk-dropdown]');
					if (dd && typeof UIkit !== 'undefined') {
						UIkit.dropdown(dd).hide();
					}
				}
			}

			function previewUploadedIcon(input, previewId, errorId, invalidFormatMsg, tooLargeMsg) {
				var errorEl = document.getElementById(errorId);
				var previewEl = document.getElementById(previewId);
				if (errorEl) {
					errorEl.textContent = '';
					errorEl.classList.add('hidden');
				}
				if (!input.files || input.files.length === 0) {
					return;
				}
				var file = input.files[0];
				var allowedExtensions = ['.png', '.jpg', '.jpeg', '.ico', '.svg', '.webp'];
				var allowedMimes = ['image/png', 'image/jpeg', 'image/x-icon', 'image/vnd.microsoft.icon', 'image/svg+xml', 'image/webp'];

				var name = file.name.toLowerCase();
				var extValid = allowedExtensions.some(function(ext) { return name.endsWith(ext); });
				var mimeValid = allowedMimes.indexOf(file.type) !== -1 || file.type === '';

				if (!extValid && !mimeValid) {
					if (errorEl) {
						errorEl.textContent = invalidFormatMsg;
						errorEl.classList.remove('hidden');
					}
					input.value = '';
					return;
				}

				if (file.size > 2 * 1024 * 1024) {
					if (errorEl) {
						errorEl.textContent = tooLargeMsg;
						errorEl.classList.remove('hidden');
					}
					input.value = '';
					return;
				}

				var reader = new FileReader();
				reader.onload = function(e) {
					if (previewEl) {
						previewEl.innerHTML = '';
						var img = document.createElement('img');
						img.src = e.target.result;
						img.alt = 'Icon preview';
						img.className = 'h-5 w-5 object-contain rounded';
						previewEl.appendChild(img);
					}
				};
				reader.readAsDataURL(file);
			}
		</script>
	</main>
}

templ PackagesIndex(title string, cmp templ.Component, commonInfo *partials.CommonInfo) {
	@layout.Base("software", commonInfo) {
		@cmp
	}
}

templ PackageModalError(message string) {
	if message != "" {
		<div class="uk-alert uk-alert-danger uk-animation-fade text-xs p-3 my-2 rounded flex items-center justify-between gap-2 border border-red-300 bg-red-50 text-red-800 dark:bg-red-950/60 dark:border-red-800 dark:text-red-200" uk-alert>
			<div class="flex items-center gap-2">
				<uk-icon icon="triangle-alert" custom-class="h-4 w-4 text-red-600 dark:text-red-400 flex-shrink-0" uk-cloak></uk-icon>
				<span class="font-medium">{ message }</span>
			</div>
			<a class="uk-alert-close text-red-600 dark:text-red-400 hover:opacity-80" uk-close></a>
		</div>
	}
}

templ NewPackageModal(commonInfo *partials.CommonInfo) {
	<div id="new-package-modal" uk-modal>
		<div class="uk-modal-dialog uk-margin-auto-vertical w-2/3">
			<button class="uk-modal-close-default dark:text-white" type="button" uk-close></button>
			<form
				hx-post={ string(templ.URL(partials.GetNavigationUrl(commonInfo, "/packages/new"))) }
				hx-encoding="multipart/form-data"
				hx-target="#main"
				hx-swap="outerHTML"
				hx-indicator="#new-package-spinner"
				hx-disabled-elt="#new-package-save-btn"
				hx-on::after-request="if (event.detail.successful) UIkit.modal('#new-package-modal').hide()"
			>
				<div class="uk-modal-header">
					<h3 class="uk-modal-title dark:text-white flex items-center gap-2">
						<uk-icon icon="package-plus" custom-class="h-5 w-5 text-primary" uk-cloak></uk-icon>
						<span>{ i18n.T(ctx, "packages.new", i18n.Default("New Package")) }</span>
					</h3>
				</div>
				<div class="uk-modal-body flex flex-col gap-4 max-h-[70vh] overflow-y-auto">
					<div id="new-package-error"></div>
					<div class="grid grid-cols-2 gap-4">
						<div>
							<label class="uk-form-label font-semibold text-xs dark:text-white">{ i18n.T(ctx, "packages.name", i18n.Default("Name")) } <span class="text-red-500">*</span></label>
							<input type="text" name="name" class="uk-input" placeholder="e.g. Mozilla Firefox" required />
						</div>
						<div>
							<label class="uk-form-label font-semibold text-xs dark:text-white">{ i18n.T(ctx, "packages.version", i18n.Default("Version")) }</label>
							<input type="text" name="version" class="uk-input" placeholder="e.g. 124.0" />
						</div>
					</div>

					<div class="grid grid-cols-2 gap-4">
						<div>
							<label class="uk-form-label font-semibold text-xs dark:text-white">{ i18n.T(ctx, "packages.category", i18n.Default("Category")) }</label>
							<input type="text" name="category" class="uk-input" placeholder="e.g. Browsers, Utilities" value="General" />
						</div>
						<div class="flex flex-col gap-1">
							<label class="uk-form-label font-semibold text-xs dark:text-white">{ i18n.T(ctx, "packages.icon", i18n.Default("Icon")) }</label>
							<div class="flex items-center gap-2">
								<div id="new-package-icon-preview" class="w-9 h-9 border border-border rounded flex items-center justify-center bg-muted/20 flex-shrink-0">
									<uk-icon icon="package" custom-class="h-4 w-4 text-primary" uk-cloak></uk-icon>
								</div>
								<input type="text" id="new-package-icon-input" name="icon" class="uk-input text-xs" placeholder="Icon name (e.g. package, globe)" />
								<div class="uk-inline flex-shrink-0">
									<button class="uk-button uk-button-default text-xs px-2 flex items-center gap-1" type="button">
										<uk-icon icon="grid" custom-class="h-3.5 w-3.5" uk-cloak></uk-icon>
										<span>{ i18n.T(ctx, "packages.pick", i18n.Default("Pick")) }</span>
									</button>
									<div uk-dropdown="mode: click; pos: bottom-right" class="w-64 p-3 bg-white dark:bg-gray-800 shadow-xl rounded-md border border-border z-50">
										<div class="text-xs font-semibold mb-2 text-muted-foreground">{ i18n.T(ctx, "packages.select_icon", i18n.Default("Select Icon")) }</div>
										<div class="grid grid-cols-6 gap-2 max-h-40 overflow-y-auto p-1">
											for _, iconName := range standardIcons {
												<button
													type="button"
													class="p-1.5 rounded hover:bg-primary/10 hover:text-primary flex items-center justify-center border border-transparent hover:border-primary/20 transition-colors"
													title={ iconName }
													onclick={ templ.ComponentScript{Call: fmt.Sprintf("selectPackageIcon('new-package-icon-input', 'new-package-icon-preview', '%s', this)", iconName)} }
												>
													<uk-icon icon={ iconName } custom-class="h-4 w-4" uk-cloak></uk-icon>
												</button>
											}
										</div>
									</div>
								</div>
							</div>
							<div class="mt-1">
								<label class="text-[11px] text-muted-foreground block mb-0.5">{ i18n.T(ctx, "packages.upload_icon", i18n.Default("Or upload custom icon (PNG, JPG, ICO, SVG, WebP, max 2MB)")) }</label>
								<input
									type="file"
									id="new-package-icon-file"
									name="icon_file"
									accept=".png,.ico,.svg,.jpg,.jpeg,.webp"
									class="uk-input text-xs"
									onchange={ templ.ComponentScript{Call: fmt.Sprintf("previewUploadedIcon(this, 'new-package-icon-preview', 'new-package-icon-error', '%s', '%s')", templ.EscapeString(i18n.T(ctx, "packages.icon_invalid_format", i18n.Default("Invalid file format. Allowed formats: PNG, JPG, ICO, SVG, WebP"))), templ.EscapeString(i18n.T(ctx, "packages.icon_too_large", i18n.Default("Icon file is too large (max 2MB)"))))} }
								/>
								<div id="new-package-icon-error" class="text-xs text-red-500 mt-1 hidden" role="alert" aria-live="polite"></div>
							</div>
						</div>
					</div>

					<div>
						<label class="uk-form-label font-semibold text-xs dark:text-white">{ i18n.T(ctx, "packages.field_description", i18n.Default("Description")) }</label>
						<textarea name="description" class="uk-textarea" rows="2" placeholder="Brief description of this software package"></textarea>
					</div>

					<div class="grid grid-cols-3 gap-4">
						<div>
							<label class="uk-form-label font-semibold text-xs dark:text-white">{ i18n.T(ctx, "packages.package_type", i18n.Default("Package Type")) } <span class="text-red-500">*</span></label>
							<select name="package_type" class="uk-select">
								<option value="msi">MSI</option>
								<option value="exe">EXE</option>
								<option value="zip">ZIP</option>
								<option value="winget">Winget</option>
							</select>
						</div>
						<div>
							<label class="uk-form-label font-semibold text-xs dark:text-white">{ i18n.T(ctx, "packages.source_type", i18n.Default("Source Type")) } <span class="text-red-500">*</span></label>
							<select
								id="new-source-type"
								name="source_type"
								class="uk-select"
								onchange="if (this.value === 'upload') { document.getElementById('new-file-section').classList.remove('hidden'); document.getElementById('new-url-section').classList.add('hidden'); } else { document.getElementById('new-file-section').classList.add('hidden'); document.getElementById('new-url-section').classList.remove('hidden'); }"
							>
								<option value="upload">{ i18n.T(ctx, "packages.upload", i18n.Default("Upload")) }</option>
								<option value="https">{ i18n.T(ctx, "packages.https", i18n.Default("HTTPS")) }</option>
							</select>
						</div>
						<div>
							<label class="uk-form-label font-semibold text-xs dark:text-white">{ i18n.T(ctx, "packages.execution_context", i18n.Default("Execution Context")) } <span class="text-red-500">*</span></label>
							<select name="execution_context" class="uk-select">
								<option value="system">SYSTEM</option>
								<option value="user">User</option>
							</select>
						</div>
					</div>

					<div id="new-file-section" class="flex flex-col gap-1">
						<label class="uk-form-label font-semibold text-xs dark:text-white">{ i18n.T(ctx, "packages.file", i18n.Default("Installation File")) }</label>
						<input type="file" name="file" class="uk-input" accept=".msi,.exe,.zip" />
						<span class="text-xs text-muted-foreground">Supported file types: .msi, .exe, .zip. SHA-256 will be calculated automatically by server.</span>
					</div>

					<div id="new-url-section" class="flex flex-col gap-1 hidden">
						<label class="uk-form-label font-semibold text-xs dark:text-white">{ i18n.T(ctx, "packages.source_url", i18n.Default("Source URL / Winget ID")) }</label>
						<input type="text" name="source_url" class="uk-input" placeholder="https://example.com/installer.msi or Winget Package ID" />
					</div>

					<div>
						<label class="uk-form-label font-semibold text-xs dark:text-white">{ i18n.T(ctx, "packages.silent_args", i18n.Default("Silent Arguments")) }</label>
						<input type="text" name="silent_args" class="uk-input font-mono text-xs" placeholder="/quiet /norestart" />
					</div>

					<div class="flex items-center gap-2 pt-2">
						<label class="flex items-center gap-2 text-sm cursor-pointer dark:text-white">
							<input type="checkbox" name="enabled" class="uk-checkbox" checked />
							<span>{ i18n.T(ctx, "packages.enabled", i18n.Default("Enabled for Self-Service")) }</span>
						</label>
					</div>
				</div>
				<div class="uk-modal-footer text-right flex justify-end gap-2">
					<button class="uk-button uk-button-default uk-modal-close" type="button">{ i18n.T(ctx, "Cancel", i18n.Default("Cancel")) }</button>
					<button id="new-package-save-btn" class="uk-button uk-button-primary flex items-center gap-2" type="submit">
						<uk-icon id="new-package-spinner" icon="loader-circle" custom-class="htmx-indicator h-4 w-4 animate-spin" uk-cloak></uk-icon>
						<uk-icon icon="save" custom-class="h-4 w-4" uk-cloak></uk-icon>
						<span>{ i18n.T(ctx, "Save", i18n.Default("Save")) }</span>
					</button>
				</div>
			</form>
		</div>
	</div>
}

templ EditPackageModal(pkg *ent.SelfServicePackage, commonInfo *partials.CommonInfo) {
	{{
		modalID := fmt.Sprintf("edit-package-modal-%s", pkg.ID.String())
		sourceTypeID := fmt.Sprintf("edit-source-type-%s", pkg.ID.String())
		fileSecID := fmt.Sprintf("edit-file-section-%s", pkg.ID.String())
		urlSecID := fmt.Sprintf("edit-url-section-%s", pkg.ID.String())
		iconInputID := fmt.Sprintf("edit-package-icon-input-%s", pkg.ID.String())
		iconPreviewID := fmt.Sprintf("edit-package-icon-preview-%s", pkg.ID.String())
		iconErrorID := fmt.Sprintf("edit-package-icon-error-%s", pkg.ID.String())
		errorID := fmt.Sprintf("edit-package-error-%s", pkg.ID.String())
		saveBtnID := fmt.Sprintf("edit-package-save-btn-%s", pkg.ID.String())
		spinnerID := fmt.Sprintf("edit-package-spinner-%s", pkg.ID.String())
	}}
	<div id={ modalID } uk-modal>
		<div class="uk-modal-dialog uk-margin-auto-vertical w-2/3">
			<button class="uk-modal-close-default dark:text-white" type="button" uk-close></button>
			<form
				hx-post={ string(templ.URL(partials.GetNavigationUrl(commonInfo, fmt.Sprintf("/packages/edit/%s", pkg.ID.String())))) }
				hx-encoding="multipart/form-data"
				hx-target="#main"
				hx-swap="outerHTML"
				hx-indicator={ fmt.Sprintf("#%s", spinnerID) }
				hx-disabled-elt={ fmt.Sprintf("#%s", saveBtnID) }
				hx-on::after-request={ templ.ComponentScript{Call: fmt.Sprintf("if (event.detail.successful) UIkit.modal('#%s').hide()", modalID)} }
			>
				<input type="hidden" name="id" value={ pkg.ID.String() } />
				<div class="uk-modal-header">
					<h3 class="uk-modal-title dark:text-white flex items-center gap-2">
						<uk-icon icon="pencil" custom-class="h-5 w-5 text-primary" uk-cloak></uk-icon>
						<span>{ i18n.T(ctx, "packages.edit", i18n.Default("Edit Package")) }</span>
					</h3>
				</div>
				<div class="uk-modal-body flex flex-col gap-4 max-h-[70vh] overflow-y-auto">
					<div id={ errorID } class="edit-package-error"></div>
					<div class="grid grid-cols-2 gap-4">
						<div>
							<label class="uk-form-label font-semibold text-xs dark:text-white">{ i18n.T(ctx, "packages.name", i18n.Default("Name")) } <span class="text-red-500">*</span></label>
							<input type="text" name="name" class="uk-input" value={ pkg.Name } required />
						</div>
						<div>
							<label class="uk-form-label font-semibold text-xs dark:text-white">{ i18n.T(ctx, "packages.version", i18n.Default("Version")) }</label>
							<input type="text" name="version" class="uk-input" value={ pkg.Version } />
						</div>
					</div>

					<div class="grid grid-cols-2 gap-4">
						<div>
							<label class="uk-form-label font-semibold text-xs dark:text-white">{ i18n.T(ctx, "packages.category", i18n.Default("Category")) }</label>
							<input type="text" name="category" class="uk-input" value={ pkg.Category } />
						</div>
						<div class="flex flex-col gap-1">
							<label class="uk-form-label font-semibold text-xs dark:text-white">{ i18n.T(ctx, "packages.icon", i18n.Default("Icon")) }</label>
							<div class="flex items-center gap-2">
								<div id={ iconPreviewID } class="w-9 h-9 border border-border rounded flex items-center justify-center bg-muted/20 flex-shrink-0">
									if pkg.Icon != "" {
										if strings.HasPrefix(pkg.Icon, "data:image/") || strings.HasPrefix(pkg.Icon, "http://") || strings.HasPrefix(pkg.Icon, "https://") {
											<img src={ pkg.Icon } class="h-4 w-4 object-contain inline-block" alt="" />
										} else {
											<uk-icon icon={ pkg.Icon } custom-class="h-4 w-4 text-primary" uk-cloak></uk-icon>
										}
									} else {
										<uk-icon icon="package" custom-class="h-4 w-4 text-muted-foreground" uk-cloak></uk-icon>
									}
								</div>
								<input type="text" id={ iconInputID } name="icon" class="uk-input text-xs" value={ pkg.Icon } />
								<div class="uk-inline flex-shrink-0">
									<button class="uk-button uk-button-default text-xs px-2 flex items-center gap-1" type="button">
										<uk-icon icon="grid" custom-class="h-3.5 w-3.5" uk-cloak></uk-icon>
										<span>{ i18n.T(ctx, "packages.pick", i18n.Default("Pick")) }</span>
									</button>
									<div uk-dropdown="mode: click; pos: bottom-right" class="w-64 p-3 bg-white dark:bg-gray-800 shadow-xl rounded-md border border-border z-50">
										<div class="text-xs font-semibold mb-2 text-muted-foreground">{ i18n.T(ctx, "packages.select_icon", i18n.Default("Select Icon")) }</div>
										<div class="grid grid-cols-6 gap-2 max-h-40 overflow-y-auto p-1">
											for _, iconName := range standardIcons {
												<button
													type="button"
													class="p-1.5 rounded hover:bg-primary/10 hover:text-primary flex items-center justify-center border border-transparent hover:border-primary/20 transition-colors"
													title={ iconName }
													onclick={ templ.ComponentScript{Call: fmt.Sprintf("selectPackageIcon('%s', '%s', '%s', this)", iconInputID, iconPreviewID, iconName)} }
												>
													<uk-icon icon={ iconName } custom-class="h-4 w-4" uk-cloak></uk-icon>
												</button>
											}
										</div>
									</div>
								</div>
							</div>
							<div class="mt-1">
								<label class="text-[11px] text-muted-foreground block mb-0.5">{ i18n.T(ctx, "packages.upload_icon", i18n.Default("Or upload custom icon (PNG, JPG, ICO, SVG, WebP, max 2MB)")) }</label>
								<input
									type="file"
									name="icon_file"
									accept=".png,.ico,.svg,.jpg,.jpeg,.webp"
									class="uk-input text-xs"
									onchange={ templ.ComponentScript{Call: fmt.Sprintf("previewUploadedIcon(this, '%s', '%s', '%s', '%s')", iconPreviewID, iconErrorID, templ.EscapeString(i18n.T(ctx, "packages.icon_invalid_format", i18n.Default("Invalid file format. Allowed formats: PNG, JPG, ICO, SVG, WebP"))), templ.EscapeString(i18n.T(ctx, "packages.icon_too_large", i18n.Default("Icon file is too large (max 2MB)"))))} }
								/>
								<div id={ iconErrorID } class="text-xs text-red-500 mt-1 hidden" role="alert" aria-live="polite"></div>
							</div>
						</div>
					</div>

					<div>
						<label class="uk-form-label font-semibold text-xs dark:text-white">{ i18n.T(ctx, "packages.field_description", i18n.Default("Description")) }</label>
						<textarea name="description" class="uk-textarea" rows="2">{ pkg.Description }</textarea>
					</div>

					<div class="grid grid-cols-3 gap-4">
						<div>
							<label class="uk-form-label font-semibold text-xs dark:text-white">{ i18n.T(ctx, "packages.package_type", i18n.Default("Package Type")) } <span class="text-red-500">*</span></label>
							<select name="package_type" class="uk-select">
								<option value="msi" selected?={ pkg.PackageType == selfservicepackage.PackageTypeMsi }>MSI</option>
								<option value="exe" selected?={ pkg.PackageType == selfservicepackage.PackageTypeExe }>EXE</option>
								<option value="zip" selected?={ pkg.PackageType == selfservicepackage.PackageTypeZip }>ZIP</option>
								<option value="winget" selected?={ pkg.PackageType == selfservicepackage.PackageTypeWinget }>Winget</option>
							</select>
						</div>
						<div>
							<label class="uk-form-label font-semibold text-xs dark:text-white">{ i18n.T(ctx, "packages.source_type", i18n.Default("Source Type")) } <span class="text-red-500">*</span></label>
							<select
								id={ sourceTypeID }
								name="source_type"
								class="uk-select"
								onchange={ templ.ComponentScript{Call: fmt.Sprintf("if (this.value === 'upload') { document.getElementById('%s').classList.remove('hidden'); document.getElementById('%s').classList.add('hidden'); } else { document.getElementById('%s').classList.add('hidden'); document.getElementById('%s').classList.remove('hidden'); }", fileSecID, urlSecID, fileSecID, urlSecID)} }
							>
								<option value="upload" selected?={ pkg.SourceType == selfservicepackage.SourceTypeUpload }>{ i18n.T(ctx, "packages.upload", i18n.Default("Upload")) }</option>
								<option value="https" selected?={ pkg.SourceType == selfservicepackage.SourceTypeHTTPS }>{ i18n.T(ctx, "packages.https", i18n.Default("HTTPS")) }</option>
							</select>
						</div>
						<div>
							<label class="uk-form-label font-semibold text-xs dark:text-white">{ i18n.T(ctx, "packages.execution_context", i18n.Default("Execution Context")) } <span class="text-red-500">*</span></label>
							<select name="execution_context" class="uk-select">
								<option value="system" selected?={ pkg.ExecutionContext == selfservicepackage.ExecutionContextSystem }>SYSTEM</option>
								<option value="user" selected?={ pkg.ExecutionContext == selfservicepackage.ExecutionContextUser }>User</option>
							</select>
						</div>
					</div>

					<div id={ fileSecID } class={ "flex flex-col gap-1", templ.KV("hidden", pkg.SourceType != selfservicepackage.SourceTypeUpload) }>
						<label class="uk-form-label font-semibold text-xs dark:text-white">{ i18n.T(ctx, "packages.file", i18n.Default("Replace Installation File")) }</label>
						<input type="file" name="file" class="uk-input" accept=".msi,.exe,.zip" />
						if pkg.FilePath != "" {
							<span class="text-xs text-muted-foreground">Current file configured. Leave empty to keep existing file. SHA-256 is auto-calculated on upload.</span>
						}
					</div>

					<div id={ urlSecID } class={ "flex flex-col gap-1", templ.KV("hidden", pkg.SourceType == selfservicepackage.SourceTypeUpload) }>
						<label class="uk-form-label font-semibold text-xs dark:text-white">{ i18n.T(ctx, "packages.source_url", i18n.Default("Source URL / Winget ID")) }</label>
						<input type="text" name="source_url" class="uk-input" value={ pkg.SourceURL } placeholder="https://example.com/installer.msi" />
					</div>

					<div>
						<label class="uk-form-label font-semibold text-xs dark:text-white">{ i18n.T(ctx, "packages.silent_args", i18n.Default("Silent Arguments")) }</label>
						<input type="text" name="silent_args" class="uk-input font-mono text-xs" value={ pkg.SilentArgs } placeholder="/quiet /norestart" />
					</div>

					<div class="flex items-center gap-2 pt-2">
						<label class="flex items-center gap-2 text-sm cursor-pointer dark:text-white">
							<input type="checkbox" name="enabled" class="uk-checkbox" checked?={ pkg.Enabled } />
							<span>{ i18n.T(ctx, "packages.enabled", i18n.Default("Enabled for Self-Service")) }</span>
						</label>
					</div>
				</div>
				<div class="uk-modal-footer text-right flex justify-end gap-2">
					<button class="uk-button uk-button-default uk-modal-close" type="button">{ i18n.T(ctx, "Cancel", i18n.Default("Cancel")) }</button>
					<button id={ saveBtnID } class="uk-button uk-button-primary flex items-center gap-2" type="submit">
						<uk-icon id={ spinnerID } icon="loader-circle" custom-class="htmx-indicator h-4 w-4 animate-spin" uk-cloak></uk-icon>
						<uk-icon icon="save" custom-class="h-4 w-4" uk-cloak></uk-icon>
						<span>{ i18n.T(ctx, "Save", i18n.Default("Save")) }</span>
					</button>
				</div>
			</form>
		</div>
	</div>
}

templ DeletePackageModal(pkg *ent.SelfServicePackage, commonInfo *partials.CommonInfo) {
	{{
		modalID := fmt.Sprintf("delete-package-modal-%s", pkg.ID.String())
	}}
	<div id={ modalID } uk-modal>
		<div class="uk-modal-dialog uk-margin-auto-vertical">
			<button class="uk-modal-close-default dark:text-white" type="button" uk-close></button>
			<form
				hx-delete={ string(templ.URL(partials.GetNavigationUrl(commonInfo, fmt.Sprintf("/packages/%s", pkg.ID.String())))) }
				hx-target="#main"
				hx-swap="outerHTML"
				hx-on::after-request={ templ.ComponentScript{Call: fmt.Sprintf("if (event.detail.successful) UIkit.modal('#%s').hide()", modalID)} }
			>
				<input type="hidden" name="id" value={ pkg.ID.String() } />
				<div class="uk-modal-header">
					<h3 class="uk-modal-title dark:text-white flex items-center gap-2 text-red-600">
						<uk-icon icon="trash-2" custom-class="h-5 w-5 text-red-600" uk-cloak></uk-icon>
						<span>{ i18n.T(ctx, "packages.delete", i18n.Default("Delete Package")) }</span>
					</h3>
				</div>
				<div class="uk-modal-body">
					<p class="dark:text-white">{ i18n.T(ctx, "packages.confirm_delete", i18n.Default("Are you sure you want to delete this package?")) }</p>
					<p class="font-bold text-sm mt-2 dark:text-white">{ pkg.Name }</p>
				</div>
				<div class="uk-modal-footer text-right flex justify-end gap-2">
					<button class="uk-button uk-button-default uk-modal-close" type="button">{ i18n.T(ctx, "Cancel", i18n.Default("Cancel")) }</button>
					<button class="uk-button uk-button-danger flex items-center gap-2" type="submit">
						<uk-icon icon="trash-2" custom-class="h-4 w-4" uk-cloak></uk-icon>
						<span>{ i18n.T(ctx, "Delete", i18n.Default("Delete")) }</span>
					</button>
				</div>
			</form>
		</div>
	</div>
}
